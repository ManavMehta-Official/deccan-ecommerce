# Keep real database credentials in deployment secret storage.
DATABASE_URL="postgresql://user:password@localhost:5432/adminportal"
ALLOW_SETUP="false"
APP_ORIGIN="http://localhost:3000"
RATE_LIMIT_SECRET="replace-with-another-long-random-value"
TRUST_PROXY="false"

# Cloudflare R2 image storage. R2_PUBLIC_URL is its public development URL or a custom domain.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://pub-example.r2.dev"

LOGIN_RATE_LIMIT="10"
LOGIN_RATE_WINDOW_SECONDS="600"
ACCOUNT_RATE_LIMIT="5"
ACCOUNT_RATE_WINDOW_SECONDS="900"
SETUP_RATE_LIMIT="3"
SETUP_RATE_WINDOW_SECONDS="3600"
AUDIT_RETENTION_DAYS="365"
EMAIL_PROVIDER="console"
EMAIL_FROM="Admin Portal <noreply@example.com>"
EMAIL_REPLY_TO=""
EMAIL_ENABLED="false"
RESEND_API_KEY=""
