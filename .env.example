# Keep real database credentials in deployment secret storage.
DATABASE_URL="postgresql://user:password@localhost:5432/adminportal"

# Enable only during the one-time first-admin bootstrap, then set to false.
ALLOW_SETUP="false"

# Canonical public origin used to protect state-changing browser requests.
APP_ORIGIN="http://localhost:3000"

# HMAC secret used to protect rate-limit keys. Use a unique random value.
RATE_LIMIT_SECRET="replace-with-another-long-random-value"

# Set true only when the deployment proxy is trusted to provide these headers.
TRUST_PROXY="false"

# Optional rate-limit overrides.
LOGIN_RATE_LIMIT="10"
LOGIN_RATE_WINDOW_SECONDS="600"
ACCOUNT_RATE_LIMIT="5"
ACCOUNT_RATE_WINDOW_SECONDS="900"
SETUP_RATE_LIMIT="3"
SETUP_RATE_WINDOW_SECONDS="3600"

# Audit events older than this many days can be removed by a superadmin.
AUDIT_RETENTION_DAYS="365"

# Use console locally; configure a provider adapter before production email delivery.
EMAIL_PROVIDER="console"
EMAIL_FROM="Admin Portal <noreply@example.com>"
EMAIL_REPLY_TO=""
EMAIL_ENABLED="false"
RESEND_API_KEY=""